# ========================================================
# Sage Life & Task Operating System - Environment Config
# ========================================================

# [SECURITY] Shared bearer authentication secret
#
# Every route and the websocket are behind this one token, so it decides who
# can read and write your tasks, reminders and finances. Generate a real one:
#
#     python3 -c "import secrets; print(secrets.token_hex(24))"
#
# On the Pi this belongs in /etc/sage/sage.env (root-owned, mode 600), which
# the systemd unit reads -- never in the repository, which is public. Leave it
# unset and the backend generates one on first boot and prints where it saved
# it; open Settings in the app and paste it in.
API_SECRET=

# Optional: bakes the key into the built bundle instead of asking for it once
# per browser. Only do this for a build that never leaves your machine -- the
# bundle is committed, and the repository is public.
# VITE_API_SECRET=

# [CORS] Allowed frontend origins (comma-separated)
#
# Empty is correct for the Pi: nginx serves the app and proxies the API from
# the same origin, so no cross-origin grant is needed. Set this only for a
# separate dev server. It used to default to "*".
FRONTEND_ORIGIN=

# [ENVIRONMENT] 'development' enables auto-reload; 'production' optimizes performance
ENV=production

# [STORAGE] Directory where SQLite databases and attachments are stored
DATA_DIR=/data

# [LOCAL AI / OLLAMA]
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b

# [WEB PUSH / VAPID]
# Run deploy/generate_vapid_keys.sh on the Pi. Without these, reminders are
# not sent and the app says so in Settings rather than failing silently.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# [GEOLOCATION & USER DEFAULTS]
DEFAULT_LAT=28.6139
DEFAULT_LON=77.2090
DEFAULT_USER_NAME=Chief

# [CLOUDFLARE TUNNEL] (Optional: for zero-port-forwarding public access)
# CLOUDFLARE_TUNNEL_TOKEN=
