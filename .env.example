# ========================================================
# Sage Life & Task Operating System - Environment Config
# ========================================================

# [SECURITY] Shared bearer authentication secret
# Must be set to a strong random token. Backend will fail to start if empty.
API_SECRET=your_strong_random_secret_token_here
VITE_API_SECRET=your_strong_random_secret_token_here

# [CORS] Allowed frontend origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost

# [ENVIRONMENT] 'development' enables auto-reload; 'production' optimizes performance
ENV=production

# [STORAGE] Directory where SQLite databases and attachments are stored
DATA_DIR=/data

# [LOCAL AI / OLLAMA]
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b

# [WEB PUSH / VAPID] (Optional: Generate with web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# [GEOLOCATION & USER DEFAULTS]
DEFAULT_LAT=28.6139
DEFAULT_LON=77.2090
DEFAULT_USER_NAME=Chief

# [CLOUDFLARE TUNNEL] (Optional: for zero-port-forwarding public access)
# CLOUDFLARE_TUNNEL_TOKEN=
