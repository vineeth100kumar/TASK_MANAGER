# Environment variables for Sage Task Manager

# Primary Backend (Raspberry Pi server)
# "/" when the Pi server hosts this app itself (the default install),
# otherwise its full address, e.g. https://my-tunnel.trycloudflare.com
VITE_PI_BACKEND_URL=
# Optional: the Pi server's API_SECRET baked into the build. Prefer entering
# it in Settings > System instead, which keeps it out of the built files.
VITE_PI_API_KEY=

# Emergency Backup Backend (Google Apps Script)
VITE_GAS_URL=https://script.google.com/macros/s/AKfycbzIuKgou3uO98HBkH3olHt-JDAum6muOfR7v59VTUg72K9IkyTX9ATgK0ntZQrNdrJo/exec
VITE_GAS_AUTH_KEY=
