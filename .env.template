# Environment variables for Sage Task Manager

# Primary Backend (Raspberry Pi server)
# "/" when the Pi server hosts this app itself (the default install),
# otherwise its full address, e.g. https://my-tunnel.trycloudflare.com
VITE_PI_BACKEND_URL=
# Optional: the Pi server's API_SECRET baked into the build. Prefer entering
# it in Settings > Server & Reset instead, which keeps it out of the built files.
VITE_PI_API_KEY=

# Emergency Backup Backend (Google Apps Script)
VITE_GAS_URL=https://script.google.com/macros/s/AKfycbzZAbFXHcDt9ZfVvH9iJCLyy8AghHhGhEwZZnB6P9RSO0zjvgMcDxojKCm1-VQ1MNrg/exec
# Only used when VITE_PI_BACKEND_URL is empty (the browser talks to Apps Script
# directly). Builds for the Pi leave it out, since anyone can read the built files.
VITE_GAS_AUTH_KEY=
