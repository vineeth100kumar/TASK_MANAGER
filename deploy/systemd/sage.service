[Unit]
Description=Sage sync server and web app (Raspberry Pi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@/raspberry_pi
ExecStart=@REPO@/raspberry_pi/venv/bin/python -m uvicorn db_server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# API_SECRET, SAGE_DB_PATH and the other settings. Written by deploy/install_pi.sh.
EnvironmentFile=/etc/sage/sage.env

[Install]
WantedBy=multi-user.target
