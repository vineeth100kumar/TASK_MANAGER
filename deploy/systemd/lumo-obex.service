[Unit]
Description=LUMO Bluetooth OBEX Photo Receiver
After=bluetooth.target
Requires=bluetooth.target

[Service]
Type=simple
ExecStartPre=-/bin/chmod 777 /var/run/sdp
ExecStart=/usr/bin/obexpushd -B -o @REPO@/lumo/rpi_server/static/memories/inbox -n
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
